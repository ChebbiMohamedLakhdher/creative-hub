# PostgreSQL (Supabase: use the pooled URL on port 6543 with pgbouncer)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&sslmode=require
# Direct Postgres URL for Prisma migrations (Supabase port 5432)
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Supabase Storage (required on Vercel; local disk is used in development if these are empty)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET=uploads

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_WEBHOOK_SECRET=your_webhook_secret

# Comma-separated Clerk user IDs allowed to access /admin
ADMIN_CLERK_IDS=user_********

# Clerk URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
